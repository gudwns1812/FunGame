        "query": "label_values(jvm_info, namespace)",
        "refresh": 1,
        "includeAll": false,
        "multi": false,
        "current": {},
        "hide": 0
      },
      {
        "name": "instance",
        "label": "인스턴스",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(jvm_info{namespace=\"$namespace\"}, instance)",
        "refresh": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "hide": 0
      }
    ]
  },
