      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "sum(rate(fungame_game_timer_task_seconds_sum{namespace=\"$namespace\", instance=~\"$instance\"}[5m])) / clamp_min(sum(rate(fungame_game_timer_task_seconds_count{namespace=\"$namespace\", instance=~\"$instance\"}[5m])), 1e-9)",
          "legendFormat": "평균"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "expr": "max(fungame_game_timer_task_seconds_max{namespace=\"$namespace\", instance=~\"$instance\"})",
          "legendFormat": "최대"
        }
      ]
    },
