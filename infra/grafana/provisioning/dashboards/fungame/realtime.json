      "id": 11,
      "type": "timeseries",
      "title": "라운드 작업 처리 시간",
      "description": "예약 작업 하나가 도는 데 걸린 평균 · 최대.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
