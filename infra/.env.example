# fungame-infra 인스턴스의 compose.yml 이 ${...} 로 읽는 값입니다.
#
# 서버의 배포 디렉터리에 .env 로 복사해 채우세요.
# 실제 .env 는 비밀값이라 커밋하지 않습니다(.gitignore).
#
# 앱 인스턴스(fungame)의 .env 와는 다른 파일입니다. 섞지 마세요.

# 그라파나 admin 계정 비밀번호. 계정 이름은 compose.yml 에 admin 으로 박혀 있습니다.
# 그라파나는 이 값을 첫 기동에만 쓰지 않고 매 기동마다 반영하므로,
# 여기서 바꾸면 다음 배포에 적용됩니다.
GRAFANA_ADMIN_PASSWORD=

# 그라파나 알림을 보낼 디스코드 웹훅. deploy-infra 가 GitHub Secret DISCORD_ALERT_WEBHOOK_URL 로
# 매 배포마다 채우므로 손으로 넣지 않아도 됩니다.
DISCORD_ALERT_WEBHOOK_URL=
