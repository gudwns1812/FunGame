# compose.yml 이 ${...} 로 읽는 값들의 목록입니다.
#
# 서버의 배포 디렉터리(기본 /home/ubuntu/fungame)에 .env 로 복사해 값을 채우세요.
# 실제 .env 는 비밀값이 들어 있어 커밋하지 않습니다(.gitignore).
#
# 여기 적힌 값은 compose.yml 안의 ${...} 치환에만 쓰입니다.
# 컨테이너 안으로 실제로 들어가는 것은 compose.yml 의 environment: 에 적힌 것뿐입니다.
# 아래 "지금은 전달되지 않는 값" 절을 함께 보세요.

# ── 배포 ────────────────────────────────────────────────
# 띄울 이미지. 배포 워크플로가 성공하면 방금 올린 커밋 태그로 이 줄을 덮어씁니다.
# 비워두면 latest 가 뜨는데, 서버의 로컬 latest 는 pull 하지 않는 한 옛 이미지에 머뭅니다.
BACKEND_IMAGE=ghcr.io/gudwns1812/fungame-backend:latest

# 관리 포트(8081)를 묶을 주소. 인프라 서버의 prometheus 가 사설망으로 긁어갑니다.
# 비우면 0.0.0.0 으로 열려 관리 엔드포인트가 공개되므로 반드시 사설 IP 를 지정하세요.
MANAGEMENT_BIND_IP=127.0.0.1

# ── 애플리케이션 ────────────────────────────────────────
# 프론트엔드 오리진. 쉼표로 여러 개 지정할 수 있습니다.
CORS_ALLOWED_ORIGINS=https://www.fun-game.club,https://fun-game.club

# 비밀번호 재설정 메일에 실리는 페이지 주소. 뒤에 ?token=... 이 붙습니다.
PASSWORD_RESET_LINK_BASE_URL=https://www.fun-game.club/reset-password

# ── MySQL ───────────────────────────────────────────────
# MYSQL_USER / MYSQL_PASSWORD 는 컨테이너 생성 시 계정을 만들고,
# 백엔드의 SPRING_DATASOURCE_USERNAME / PASSWORD 로도 그대로 들어갑니다.
# 이미 데이터 볼륨이 있는 서버에서 값을 바꾸면 계정이 새로 만들어지지 않아 접속이 깨집니다.
MYSQL_USER=fungame
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ── Brevo SMTP (비밀번호 재설정 메일) ───────────────────
# 배포할 때마다 GitHub Secret BREVO_SMTP_LOGIN · BREVO_SMTP_KEY 로 덮어씁니다.
# 서버에서 손으로 바꿔도 다음 배포에서 Secret 값으로 돌아가니 Secret 을 고치세요.
MAIL_USERNAME=
MAIL_PASSWORD=

# ── Discord (신고 알림) ─────────────────────────────────
# 정답과 힌트까지 실리므로 비공개 채널이어야 합니다.
# 주소를 아는 사람은 누구나 그 채널에 메시지를 쏠 수 있으므로 여기에만 둡니다.
DISCORD_REPORT_WEBHOOK_URL=

# ── 지금은 전달되지 않는 값 ─────────────────────────────
# 아래 네 개는 앱 설정이 읽지만 compose.yml 의 environment: 에 없습니다.
# .env 에 적어도 컨테이너로 전달되지 않으니, 쓰려면 compose.yml 에 먼저 추가해야 합니다.
#
#   JPA_DDL_AUTO              기본 validate  (db-core.yml)
#   METRICS_NAMESPACE         기본 prod      (monitoring.yml)
#   SESSION_COOKIE_SECURE     기본 true      (application.yml)
#   SESSION_COOKIE_SAME_SITE  기본 lax       (application.yml)
#
# 특히 db-core.yml 에는 "배포가 막히면 .env 에서 JPA_DDL_AUTO=none 으로 내리세요" 라고
# 적혀 있는데, 지금 배선으로는 그렇게 해도 먹지 않습니다. 급할 때 통하지 않는 탈출구입니다.

# ── 여기 넣을 필요가 없는 값 ───────────────
# 아래 셋은 compose.yml 이 컨테이너로 넘기지 않습니다. 기본값이 이미 운영값이라
# .env 를 경유시킬 이유가 없고, 경유시키면 비었을 때 기본값을 덮어 더 나빠집니다.
#
#   MAIL_HOST                 기본 smtp-relay.brevo.com            (client-mail.yml)
#   MAIL_FROM                 기본 no-reply@fun-game.club          (client-mail.yml)
#   PASSWORD_RESET_LINK_BASE_URL  기본 https://www.fun-game.club/reset-password
#
# 환경마다 달라져야 하면 compose.yml 의 environment 에 되살리고 여기도 함께 채우세요.
